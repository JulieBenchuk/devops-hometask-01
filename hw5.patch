@@ -0,0 +1,29 @@
+# Конфигурация сбора метрик для hw5.
+#
+# Prometheus работает по pull-модели: периодически опрашивает targets и
+# скачивает метрики по HTTP. Каждый таргет должен отдавать на /metrics
+# текст в формате Prometheus exposition.
+#
+# Targets указаны через service-имена docker-compose сети (`back`, `node-exporter`),
+# а не через localhost — внутри docker-сети сервисы видят друг друга по именам.
+
+global:
+  scrape_interval: 15s
+  evaluation_interval: 15s
+
+scrape_configs:
+  # Сам Prometheus тоже отдаёт метрики на /metrics.
+  - job_name: 'prometheus'
+    static_configs:
+      - targets: ['localhost:9090']
+
+  # Системные метрики хоста: CPU, RAM, диск, сеть.
+  - job_name: 'node-exporter'
+    static_configs:
+      - targets: ['node-exporter:9100']
+
+  # Метрики NestJS-приложения: default Node.js + кастомный HTTP-гистограмма.
+  # Порт 3000 — внутренний порт контейнера back в docker-сети.
+  - job_name: 'back'
+    static_configs:
+      - targets: ['back:3000']
diff --git a/monitoring/promtail-config.yaml b/monitoring/promtail-config.yaml
new file mode 100644
index 0000000..76b2ce6
--- /dev/null
+++ b/monitoring/promtail-config.yaml
@@ -0,0 +1,44 @@
+# Конфигурация Promtail для hw5 — собирает логи из всех контейнеров docker.
+#
+# docker_sd_configs делает service discovery через Docker API: Promtail сам
+# находит все запущенные контейнеры, не нужно перечислять каждый.
+# relabel_configs прокидывает Docker-метаданные в лейблы Loki:
+#   - container — имя контейнера (с обрезанным ведущим слэшем)
+#   - service   — имя сервиса docker-compose (по нему фильтруем в Grafana)
+#   - image     — образ
+# По этим лейблам потом ищем логи через LogQL.
+
+server:
+  http_listen_port: 9080
+  grpc_listen_port: 0
+
+positions:
+  filename: /tmp/positions.yaml
+
+clients:
+  - url: http://loki:3100/loki/api/v1/push
+
+scrape_configs:
+  - job_name: docker
+    pipeline_stages:
+      - docker: {}
+
+    docker_sd_configs:
+      - host: unix:///var/run/docker.sock
+
+    relabel_configs:
+      - source_labels: ['__meta_docker_container_name']
+        target_label: 'container'
+        regex: '/(.*)'
+
+      - source_labels: ['__meta_docker_container_id']
+        target_label: 'container_id'
+
+      - source_labels: ['__meta_docker_container_image']
+        target_label: 'image'
+
+      - source_labels: ['__meta_docker_container_label_com_docker_compose_service']
+        target_label: 'service'
+
+      - source_labels: ['__meta_docker_container_log_stream']
+        target_label: 'stream'
diff --git a/scripts/smoke.sh b/scripts/smoke.sh
new file mode 100755
index 0000000..d48552c
--- /dev/null
+++ b/scripts/smoke.sh
@@ -0,0 +1,45 @@
+#!/usr/bin/env bash
+# Smoke-проверка задеплоенного стека для hw4+hw5 — лёгкий read-only health check.
+#
+# Используется в job'е `verify` пайплайна и доступна локально через `make smoke-deployed`.
+# В отличие от `make e2e-deployed` (Playwright + reset todos) — НЕ мутирует данные:
+# только проверяет, что /api/health отвечает 200 со status=ok, что фронт отдаёт HTML
+# и (с hw5) что /api/metrics отдаёт текст в формате Prometheus exposition.
+#
+# Требует переменную окружения E2E_BASE_URL (вида https://your-domain.example).
+# Обычно подгружается из .env.production.e2e через `make smoke-deployed`.
+
+set -euo pipefail
+
+: "${E2E_BASE_URL:?E2E_BASE_URL must be set (e.g. https://your-domain.example)}"
+
+# Нормализуем trailing slash — на всякий случай.
+BASE="${E2E_BASE_URL%/}"
+
+echo "→ GET ${BASE}/api/health"
+HEALTH=$(curl -sSf --max-time 10 "${BASE}/api/health")
+echo "  ${HEALTH}"
+echo "${HEALTH}" | grep -q '"status":"ok"' || {
+  echo "✗ /api/health did not return status=ok"
+  exit 1
+}
+
+echo "→ GET ${BASE}/"
+INDEX=$(curl -sSf --max-time 10 "${BASE}/")
+echo "${INDEX}" | grep -qi '<title' || {
+  echo "✗ frontend did not return HTML (no <title> tag)"
+  exit 1
+}
+
+echo "→ GET ${BASE}/api/metrics"
+METRICS=$(curl -sSf --max-time 10 -H 'Accept: text/plain' "${BASE}/api/metrics")
+echo "${METRICS}" | grep -q '^# HELP' || {
+  echo "✗ /api/metrics did not return Prometheus exposition format (no '# HELP' lines)"
+  exit 1
+}
+echo "${METRICS}" | grep -q 'nodejs_heap_size_used_bytes' || {
+  echo "✗ /api/metrics missing default Node.js metrics (nodejs_heap_size_used_bytes)"
+  exit 1
+}
+
+echo "✓ smoke checks passed"
