+++ b/monitoring/loki-config.yaml
@@ -0,0 +1,32 @@
+# Конфигурация Loki для hw5 — single-node, без авторизации.
+#
+# Этого достаточно для учебного приложения и одного VPS. Под прод-нагрузку
+# Loki разворачивается distributed (отдельный distributor, ingester, querier),
+# но это сильно за пределами курса.
+
+auth_enabled: false
+
+server:
+  http_listen_port: 3100
+
+common:
+  ring:
+    instance_addr: 127.0.0.1
+    kvstore:
+      store: inmemory
+  replication_factor: 1
+  path_prefix: /tmp/loki
+
+schema_config:
+  configs:
+    - from: 2020-05-15
+      store: tsdb
+      object_store: filesystem
+      schema: v13
+      index:
+        prefix: index_
+        period: 24h
+
+storage_config:
+  filesystem:
+    directory: /tmp/loki/chunks
