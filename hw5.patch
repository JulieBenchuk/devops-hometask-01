@@ -0,0 +1,23 @@
+# Provisioning datasources для Grafana — hw5.
+#
+# При старте Grafana читает этот файл и автоматически подключает Prometheus
+# и Loki. Не нужно ходить в UI и добавлять руками.
+#
+# URL'ы используют service-имена docker-сети (`prometheus`, `loki`), а не
+# localhost — Grafana обращается к ним изнутри docker-сети.
+
+apiVersion: 1
+
+datasources:
+  - name: Prometheus
+    type: prometheus
+    access: proxy
+    url: http://prometheus:9090
+    isDefault: true
+    editable: true
+
+  - name: Loki
+    type: loki
+    access: proxy
+    url: http://loki:3100
+    editable: true
diff --git a/monitoring/loki-config.yaml b/monitoring/loki-config.yaml
new file mode 100644
index 0000000..6e6a085
--- /dev/null
+++ b/monitoring/loki-config.yaml
@@ -0,0 +1,32 @@
+# Конфигурация Loki для hw5 — single-node, без авторизации.
+#
+# Этого достаточно для учебного приложения и одного VPS. Под прод-нагрузку
+# Loki разворачивается distributed (отдельный distributor, ingester, querier),
+# но это сильно за пределами курса.
+
+auth_enabled: false
+
+server:
+  http_listen_port: 3100
+
+common:
+  ring:
+    instance_addr: 127.0.0.1
+    kvstore:
+      store: inmemory
+  replication_factor: 1
+  path_prefix: /tmp/loki
+
+schema_config:
+  configs:
+    - from: 2020-05-15
+      store: tsdb
+      object_store: filesystem
+      schema: v13
+      index:
+        prefix: index_
+        period: 24h
+
+storage_config:
+  filesystem:
+    directory: /tmp/loki/chunks
diff --git a/monitoring/prometheus.yml b/monitoring/prometheus.yml
new file mode 100644
index 0000000..2ffe273
--- /dev/null
+++ b/monitoring/prometheus.yml
@@ -0,0 +1,29 @@
+# Конфигурация сбора метрик для hw5.
+#
+# Prometheus работает по pull-модели: периодически опрашивает targets и
+# скачивает метрики по HTTP. Каждый таргет должен отдавать на /metrics
+# текст в формате Prometheus exposition.
+#
+# Targets указаны через service-имена docker-compose сети (`back`, `node-exporter`),
+# а не через localhost — внутри docker-сети сервисы видят друг друга по именам.
+
+global:
+  scrape_interval: 15s
+  evaluation_interval: 15s
+
+scrape_configs:
+  # Сам Prometheus тоже отдаёт метрики на /metrics.
+  - job_name: 'prometheus'
+    static_configs:
+      - targets: ['localhost:9090']
+
+  # Системные метрики хоста: CPU, RAM, диск, сеть.
+  - job_name: 'node-exporter'
+    static_configs:
+      - targets: ['node-exporter:9100']
+
+  # Метрики NestJS-приложения: default Node.js + кастомный HTTP-гистограмма.
+  # Порт 3000 — внутренний порт контейнера back в docker-сети.
+  - job_name: 'back'
+    static_configs:
+      - targets: ['back:3000']
diff --git a/monitoring/promtail-config.yaml b/monitoring/promtail-config.yaml
new file mode 100644
index 0000000..76b2ce6
--- /dev/null
+++ b/monitoring/promtail-config.yaml
@@ -0,0 +1,44 @@
+# Конфигурация Promtail для hw5 — собирает логи из всех контейнеров docker.
+#
+# docker_sd_configs делает service discovery через Docker API: Promtail сам
+# находит все запущенные контейнеры, не нужно перечислять каждый.
+# relabel_configs прокидывает Docker-метаданные в лейблы Loki:
+#   - container — имя контейнера (с обрезанным ведущим слэшем)
+#   - service   — имя сервиса docker-compose (по нему фильтруем в Grafana)
+#   - image     — образ
+# По этим лейблам потом ищем логи через LogQL.
+
+server:
+  http_listen_port: 9080
+  grpc_listen_port: 0
+
+positions:
+  filename: /tmp/positions.yaml
+
+clients:
+  - url: http://loki:3100/loki/api/v1/push
+
+scrape_configs:
+  - job_name: docker
+    pipeline_stages:
+      - docker: {}
+
+    docker_sd_configs:
+      - host: unix:///var/run/docker.sock
+
+    relabel_configs:
+      - source_labels: ['__meta_docker_container_name']
+        target_label: 'container'
+        regex: '/(.*)'
+
+      - source_labels: ['__meta_docker_container_id']
+        target_label: 'container_id'
+
+      - source_labels: ['__meta_docker_container_image']
+        target_label: 'image'
+
+      - source_labels: ['__meta_docker_container_label_com_docker_compose_service']
+        target_label: 'service'
+
+      - source_labels: ['__meta_docker_container_log_stream']
+        target_label: 'stream'
